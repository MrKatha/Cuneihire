{
  "manifest_version": 3,
  "name": "Cuneihire — LinkedIn Connect",
  "version": "1.1",
  "description": "Securely connects your LinkedIn session to Cuneihire so it can automate outreach on your behalf.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Cuneihire — LinkedIn Connect",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://hire.cuneihive.com/*",
    "https://bulk-email.ismailabbasi.qzz.io/*",
    "https://viddr.ismailabbasi.qzz.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://hire.cuneihive.com/*",
        "https://bulk-email.ismailabbasi.qzz.io/*",
        "https://viddr.ismailabbasi.qzz.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
