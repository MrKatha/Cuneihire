{
  "manifest_version": 3,
  "name": "Cuneihire LinkedIn Cookie Extractor",
  "version": "1.0",
  "description": "Automatically extracts your LinkedIn JSESSIONID for the Cuneihire application.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://bulk-email.ismailabbasi.qzz.io/*",
    "https://viddr.ismailabbasi.qzz.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://bulk-email.ismailabbasi.qzz.io/*",
        "https://viddr.ismailabbasi.qzz.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
